# Plantilla. Los archivos por ambiente ya versionados son .env.development, .env.qa y .env.production.
# Sólo variables públicas: todo VITE_* queda embebido en el bundle. Nunca secretos aquí.

# API (vacío = mismo origen; en dev se resuelve por el proxy de Vite)
VITE_API_BASE_URL=

# development | qa | production
VITE_ENVIRONMENT=development

# Franja de ambiente visible en la UI
VITE_SHOW_ENV_BANNER=true

# true = datos sintéticos, prohibido capturar pacientes reales
VITE_IS_DEMO=true

# Destino del proxy /api del servidor de desarrollo
VITE_API_PROXY_TARGET=http://localhost:5080

# Tenant con el que se autentica el cliente.
# Provisional: la resolución definitiva (subdominio o selector) está por definirse.
VITE_TENANT_CODE=demo
