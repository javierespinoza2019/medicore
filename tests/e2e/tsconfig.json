{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@fixtures/*": ["fixtures/*"],
      "@helpers/*": ["helpers/*"],
      "@data/*": ["data/*"]
    }
  },
  "include": [
    "specs/**/*.ts",
    "fixtures/**/*.ts",
    "helpers/**/*.ts",
    "data/**/*.ts",
    "utils/**/*.ts",
    "guided/**/*.ts",
    "playwright.config.ts"
  ]
}
