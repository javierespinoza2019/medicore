# URL del prototipo UI (docs/frontend) o de un ambiente con backend.
MEDICORE_BASE_URL=http://localhost:5173

# API real para la suite de contrato (proyecto `contrato-api`).
MEDICORE_API_URL=http://localhost:5080

# mock    = prototipo sin backend; lo que exige API queda en test.skip.
# backend = hay API real; se habilitan cola, idempotencia, multi-tenant, etc.
MEDICORE_E2E_MODE=mock

# Credenciales de prueba (docs/frontend/src/mocks/users.ts). Nunca producción.
MEDICORE_E2E_PASSWORD=Admin123!

# Tenants ficticios (sólo relevantes con MEDICORE_E2E_MODE=backend).
MEDICORE_TENANT_A=tenant-alfa-ficticio
MEDICORE_TENANT_B=bravo

MEDICORE_TIMEOUT=45000
