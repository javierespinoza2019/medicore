<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cd2f357f-2959-4314-b3f6-6d3a0cd24ecb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- NU1903 / CVE-2026-49451 (GHSA-v5pm-xwqc-g5wc): Microsoft.AspNetCore.OpenApi 10.0.10 arrastra
         Microsoft.OpenApi 2.0.0, vulnerable a DoS por referencias circulares. Parche de la línea 2.x: 2.7.5.
         Se fija explícitamente para elevar la transitiva sin cambiar de major (AddOpenApi sigue igual). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Business\MediCore.Business.csproj" />
    <ProjectReference Include="..\Common\MediCore.Common.csproj" />
    <ProjectReference Include="..\Models\MediCore.Models.csproj" />
    <ProjectReference Include="..\DataAccess\MediCore.DataAccess.csproj" />
  </ItemGroup>

</Project>
