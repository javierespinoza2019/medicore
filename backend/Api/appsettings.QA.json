{
  "//": "QA: datos sintéticos, sin PHI. Secretos por variables de entorno (ConnectionStrings__MediCore, Jwt__SigningKey).",
  "Jwt": {
    "Issuer": "MediCore.QA",
    "Audience": "MediCore.QA",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Platform": {
    "IsDemo": true,
    "AllowSyntheticSeed": true,
    "AllowRealPatientData": false,
    "DgisDestination": "non-production",
    "ShowEnvironmentBanner": true
  },
  "Cors": {
    "Origins": [ "https://qa.medicore.mx" ]
  },
  "Serilog": {
    "MinimumLevel": "Warning"
  },
  "AllowedHosts": "qa.medicore.mx"
}
