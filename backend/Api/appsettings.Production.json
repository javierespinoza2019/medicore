{
  "Jwt": {
    "Issuer": "MediCore",
    "Audience": "MediCore",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Platform": {
    "IsDemo": false,
    "AllowSyntheticSeed": false,
    "AllowRealPatientData": false,
    "DgisDestination": "non-production",
    "ShowEnvironmentBanner": false
  },
  "Cors": {
    "Origins": [
      "https://medi-core.app",
      "https://www.medi-core.app"
    ]
  },
  "Serilog": {
    "MinimumLevel": "Error"
  },
  "AllowedHosts": "api.medi-core.app;medi-core.app;www.medi-core.app"
}
